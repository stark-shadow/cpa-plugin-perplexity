{
  "manifest_version": 3,
  "name": "CPA Perplexity Session Capture",
  "version": "1.1.0",
  "description": "Capture a signed-in Perplexity session and import it into your local CPA plugin.",
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": ["https://www.perplexity.ai/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html"},
  "content_scripts": [{
    "matches": ["http://127.0.0.1/v0/resource/plugins/perplexity/*", "http://localhost/v0/resource/plugins/perplexity/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
